<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    style="@style/Widget.Setbd.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingLeft="10dp"
                android:paddingTop="3dp"
                android:paddingRight="10dp"
                android:paddingBottom="3dp"
                android:text="HIGH"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fCvss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="CVSS ~7.5"
                android:textColor="@color/textSub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Finding title"
            android:textColor="@color/textMain"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="detail"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/fUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="url"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_console"
            android:padding="8dp"
            android:text="evidence"
            android:textColor="@color/textSub"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/fReco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="recommendation"
            android:textColor="@color/textMain"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
