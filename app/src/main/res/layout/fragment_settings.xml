<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Setbd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Setbd.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appearance" />

                <RadioGroup
                    android:id="@+id/themeRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automatic (system)"
                        android:textColor="@color/textMain" />

                    <RadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:textColor="@color/textMain" />

                    <RadioButton
                        android:id="@+id/rbDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:textColor="@color/textMain" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Setbd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Setbd.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Defaults" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/safeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Safe mode by default"
                    android:textColor="@color/textMain"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/localSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow local/private targets by default"
                    android:textColor="@color/textMain"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/rateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Default rate limit: 300 ms between requests"
                    android:textColor="@color/textSub"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/rateBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1900"
                    android:progress="300" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Custom User-Agent"
                    android:textColor="@color/textSub"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/uaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:padding="10dp"
                    android:textColor="@color/textMain"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Setbd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Setbd.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data &amp; Audit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auditBtn"
                    style="@style/Widget.Setbd.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="View audit log"
                    app:icon="@drawable/ic_history" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearBtn"
                    style="@style/Widget.Setbd.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Clear all local data"
                    app:icon="@drawable/ic_stop"
                    app:iconTint="@color/danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Setbd.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Setbd.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="SETBD Scanner v1.0.0\nAll-in-one mobile website pentesting &amp; security research suite.\n\nEvery scan is audit-logged locally. Tools marked NATIVE run on-device; TERMUX/EXTERNAL tools are documented with honest setup steps — the app never fakes tool output.\n\nUse only against systems you own or have written authorization to test."
                    android:textColor="@color/textSub"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
