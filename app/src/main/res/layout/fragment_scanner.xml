<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Setbd.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Setbd.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Scan" />

                    <EditText
                        android:id="@+id/targetInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="https://authorized-target.com"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:padding="12dp"
                        android:textColor="@color/textMain"
                        android:textColorHint="@color/textSub"
                        android:textSize="14sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/safeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:checked="true"
                        android:text="Safe mode (benign probes only)"
                        android:textColor="@color/textMain"
                        android:textSize="13sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/localSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allow local/private targets"
                        android:textColor="@color/textMain"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/chkAuth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I am authorized to test this target"
                        android:textColor="@color/textMain"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Scan modules"
                        android:textColor="@color/textSub"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/modRecon"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Recon"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/modHttp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Headers"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/modTls"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="TLS"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/modPorts"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Ports"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/modInject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SQLi/XSS probe"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/modCrawl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Crawl"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/modOsint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OSINT"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Request rate limit: 300 ms"
                        android:textColor="@color/textSub"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/rateBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1900"
                        android:progress="300" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startBtn"
                            style="@style/Widget.Setbd.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Start scan"
                            app:icon="@drawable/ic_send" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopBtn"
                            style="@style/Widget.Setbd.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Stop"
                            app:icon="@drawable/ic_stop"
                            app:iconTint="@color/danger" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openReportBtn"
                        style="@style/Widget.Setbd.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Open last report"
                        app:icon="@drawable/ic_doc" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/progressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Idle. Configure modules and start."
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/consoleScroll"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_console">

                <TextView
                    android:id="@+id/console"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="SETBD Scanner console ready.\n"
                    android:textColor="@color/textMain"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
